[gd_resource type="Resource" script_class="DialogueSequence" format=3]

[ext_resource type="Script" path="res://scripts/dialogue/DialogueSequence.gd" id="1_seq"]
[ext_resource type="Script" path="res://scripts/dialogue/DialogueLine.gd" id="2_line"]
