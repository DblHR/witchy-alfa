        {
          "speaker": "rikka",
          "speaker_name": "",
          "emotion": "epiphany",
          "text": "..."
        },
        {
          "speaker": "rikka",
          "speaker_name": "",
          "emotion": "wise",
          "text": "Раз уж мы партнёры, я доверяю тебе дать ему имя!"
        },
        {
          "speaker": "hero",
          "speaker_name": "",
          "emotion": "confusion",
          "text": "Тебе ведь просто лень?"
        },
        {
          "speaker": "rikka",
          "speaker_name": "",
          "emotion": "smile",
          "text": "Е-хе-хе~"
        },
        {
          "speaker": "rikka",
          "speaker_name": "",
          "emotion": "intellect",
          "text": "Давай-давай, ты наверняка придумаешь что-то интересное!",
          "ask_name": {
            "key": "rikka_flower",
            "title": "Как назовём цветок?",
            "default": "Цветочек"
          }
