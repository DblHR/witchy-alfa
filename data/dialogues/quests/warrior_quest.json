{
  "dialogues": [
    {
      "id": "find_warrior_room_intro",
      "type": "quest_room",
      "quest": "find_warrior",
      "once": true,
      "priority": 100,
      "conditions": {
        "quest_active": "find_warrior",
        "not_flag": "find_warrior_room_done"
      },
      "on_finish": {
        "set_flags": ["find_warrior_room_done"],
        "start_quest_battle": true
      },
      "lines": [
        {
          "speaker": "fufu",
          "speaker_name": "Зелёная девушка-слизень",
          "emotion": "",
          "text": "Оо, смотри-ка, мальчик, тут ещё один человечек пришёл! Кажется, становится всё интереснее и интереснее!",
          "characters": [{"id": "witch"}, {"id": "warrior"}, {"id": "fufu"}]
        },
        {
          "speaker": "warrior",
          "speaker_name": "",
          "emotion": "",
          "text": "Беги отсюда! Она очень сильна!",
          "characters": [{"id": "witch"}, {"id": "warrior"}, {"id": "fufu"}]
        },
        {
          "speaker": "witch",
          "speaker_name": "",
          "emotion": "",
          "text": "И УПУСТИТЬ ВОЗМОЖНОСТЬ ИССЛЕДОВАТЬ ТАКОЙ ОБРАЗЕЦ? НУ УЖ НЕТ!",
          "characters": [{"id": "witch"}, {"id": "warrior"}, {"id": "fufu"}]
        }
      ]
    },
    {
      "id": "find_warrior_after_battle",
      "type": "vn_scene",
      "quest": "find_warrior",
      "once": true,
      "priority": 100,
      "on_finish": {
        "complete_quest": "find_warrior",
        "unlock_unit": "warrior"
      },
      "lines": [
        {
          "speaker": "warrior",
          "speaker_name": "",
          "emotion": "",
          "text": "Фух, спаслись! Правда, ты, кажется, не спешила убегать...",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        },
        {
          "speaker": "witch",
          "speaker_name": "",
          "emotion": "",
          "text": "Упустили! Мы её упустили! Какой ужас...",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        },
		{
          "speaker": "warrior",
          "speaker_name": "",
          "emotion": "",
          "text": "Упустили? Мы бы там погибли, если бы не твой камешек.",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        },
		{
          "speaker": "witch",
          "speaker_name": "",
          "emotion": "",
          "text": "*Вздох*",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        },
		{
          "speaker": "witch",
          "speaker_name": "",
          "emotion": "",
          "text": "Кто это вообще была?",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        },
		{
          "speaker": "warrior",
          "speaker_name": "",
          "emotion": "",
          "text": "Фуфу... Главная у слизней. Уже неделю я не могу с ней справиться и пройти дальше.",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        },
		{
          "speaker": "witch",
          "speaker_name": "",
          "emotion": "",
          "text": "Ты тоже пытаешься добраться до самого низа?",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        },
		{
          "speaker": "witch",
          "speaker_name": "",
          "emotion": "",
          "text": "Мне очень нужно пройти до самого конца подземелья, иначе я вылечу из академии.",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        },
		{
          "speaker": "warrior",
          "speaker_name": "",
          "emotion": "",
          "text": "Это подземелье смертельно опасно, а ты переживаешь о своём обучении?",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        },
		{
          "speaker": "witch",
          "speaker_name": "",
          "emotion": "",
          "text": "Если я вылечу из академии, то дома меня всё равно прибьют...",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        },
		{
          "speaker": "warrior",
          "speaker_name": "",
          "emotion": "",
          "text": "Справедливо.",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        },
		{
          "speaker": "warrior",
          "speaker_name": "",
          "emotion": "",
          "text": "...",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        },
		{
          "speaker": "witch",
          "speaker_name": "",
          "emotion": "",
          "text": "...",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        },
		{
          "speaker": "warrior",
          "speaker_name": "",
          "emotion": "",
          "text": "А как мы оказались в моём доме?",
          "characters": [{"id": "witch"}, {"id": "warrior"}]
        }
      ]
    }
  ]
}
