        {"go": "warrior", "to": "CauldronLeft"},
        {"go": "witch", "to": "CauldronRight"},
        {"face": "warrior", "to": "Cauldron"},
        {"face": "witch", "to": "Cauldron"},
        {"wait": 0.4},
        {"say": "Рванёт?", "who": "warrior"},
        {"wait": 2.6},
        {"say": "Не должно...", "who": "witch"},
        {"wait": 2.6}
